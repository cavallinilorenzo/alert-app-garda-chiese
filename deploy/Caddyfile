{$DOMAIN:garda-chiese.simonetrentin.me} {
    # 1. File statici e media del backend Django
    handle /static/* {
        root * /srv/backend
        file_server
    }
    
    handle /media/* {
        root * /srv/backend
        file_server
    }

    # 2. API e Pannello Admin (Django)
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /admin/* {
        reverse_proxy backend:8000
    }

    # 3. Portale Operatore (React SPA)
    handle_path /portale* {
        root * /srv/portale
        try_files {path} /index.html
        file_server
    }

    # 4. App di Segnalazione (React SPA) - Default fallback
    handle {
        root * /srv/segnalazione
        try_files {path} /index.html
        file_server
    }
}
