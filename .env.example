# Copia in .env (che è nel gitignore) e metti i valori veri.
# I segreti si passano in privato, mai nella repo.

# Django. La chiave firma anche i JWT: almeno 32 caratteri. Per generarla:
#   cd backend && uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambiami
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres: li usano sia docker compose sia Django
POSTGRES_DB=garda_chiese
POSTGRES_USER=garda_chiese
POSTGRES_PASSWORD=cambiami
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Estrazione vocale. La chiave si crea su https://aistudio.google.com/apikey.
# Vuota: l'endpoint risponde 503 e l'App fa compilare il form a mano.
GEMINI_API_KEY=
GEMINI_MODELLO=gemini-3.1-flash-lite

# Web Push (generare una coppia VAPID e conservarla solo nel file .env)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Email per le nuove Segnalazioni. Vuoto: invio disabilitato.
# Per Gmail: smtp.gmail.com, porta 587, TLS e password per le app.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_TIMEOUT=10
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_NOTIFICATION_RECIPIENT=
DEFAULT_FROM_EMAIL=
